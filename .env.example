# ============================================================
# Nexa Store — environment template
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- Auth (required for the hidden /login dashboard) ----------
AUTH_ADMIN_EMAIL=admin@example.com
AUTH_ADMIN_PASSWORD=change-me
AUTH_DEVELOPER_EMAIL=developer@example.com
AUTH_DEVELOPER_PASSWORD=change-me

# 32+ byte random hex — signs the HTTP-only session cookie.
# Generate: openssl rand -hex 32
SESSION_SECRET=

# --- Version label shown in the footer (optional) ------------
NEXT_PUBLIC_APP_VERSION=1.0.0

# --- Catalog persistence (optional) --------------------------
# By default the catalog is read from data/*.json bundled with the
# deployment ("local" mode — read-only on serverless hosting).
# To enable write-through-GitHub persistence (admin edits commit
# back to the repo), set ALL of the following:
# GITHUB_OWNER=your-username
# GITHUB_REPOSITORY=nexastore
# GITHUB_BRANCH=main
# GITHUB_TOKEN=<fine-grained PAT with Contents: read/write>
# GITHUB_COMMITTER_NAME=Nexa Store Bot
# GITHUB_COMMITTER_EMAIL=bot@example.com

# --- Telegram webhook runtime (optional; the bot can run on Vercel) ----
# TELEGRAM_BOT_TOKEN=123456789:AAA-your-bot-token
# TELEGRAM_WEBHOOK_SECRET=shared-secret-for-webhook-route
# NEXA_API_BASE=https://your-production-url
# NEXA_DEV_EMAIL=developer@example.com
# NEXA_DEV_PASSWORD=change-me

# --- Bot service launcher (sandbox only; 404 in production) ------------
# BOT_SERVICE_LAUNCH=1
