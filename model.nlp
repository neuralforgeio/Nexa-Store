o 8400 gcube"],["en","8400 gcube blockman go"],["en","8400 gcubes blockman go"],["en","blockman go 8400 cube"],["en","8400 cube blockman go"],["en","8400 blockman go"],["en","blockmango 8400 gcubes"],["en","harga 8400 gcubes blockmango"],["en","blockmango 8400 gcubes berapa"],["en","blockmango 8400"],["en","blockmango 8400 gcube"],["en","8400 gcube blockmango"],["en","8400 gcubes blockmango"],["en","blockmango 8400 cube"],["en","8400 cube blockmango"],["en","8400 blockmango"],["en","rekomendasi termurah"],["en","top up paling murah"],["en","yang paling murah"],["en","harga termurah"],["en","top up murah"],["en","budget tipis"],["en","duit tipis"],["en","murah banget apa"],["en","paling hemat"],["en","rekomendasi murah"],["en","yang murah apa"],["en","top up dibawah 20 ribu"],["en","budget 10 ribu"],["en","budget 20 ribu"],["en","hemat duit"],["en","yang paling murah apa"],["en","top up kecil"],["en","top up dibawah 15 ribu"],["en","dibawah 20rb"],["en","murah"],["en","game populer"],["en","game terlaris"],["en","rekomendasi game"],["en","game yang lagi rame"],["en","yang sering dibeli"],["en","game recommended"],["en","top game"],["en","game terbaik"],["en","game favorit"],["en","rekomendasi top up"],["en","mau top up apa ya"],["en","bingung mau top up apa"],["en","saran game dong"],["en","game apa yang bagus"],["en","bonus paling besar"],["en","paling worth it"],["en","best value"],["en","yang paling worth"],["en","hemat bonus"],["en","bonus terbanyak"],["en","yang ada bonusnya"],["en","paling untung"],["en","worth it yang mana"],["en","hadiah buat teman"],["en","kado buat pacar"],["en","hadiah buat gamer"],["en","gift card"],["en","kado gaming"],["en","hadiah ultah gamer"],["en","buat hadiah apa ya"]]},"ner":{"settings":{"tag":"ner"},"rules":{}},"nlgManager":{"settings":{"tag":"nlg-manager"},"responses":{"en":{"greet":[{"answer":"Halo! 👋 Aku Nexa Bot, asisten NEXA STORE ⚡ Ketik nama game buat lihat daftar harga (mis. \"free fire\"), atau tanya \"berapa total game\", \"cara top up\", \"lacak pesanan\", dan \"rekomendasi termurah\"."}],"bot.identity":[{"answer":"Aku Nexa Bot ⚡ — asisten AI NEXA STORE, toko top up game favoritmu. Otakku dilatih dari data katalog store ini dan diproses sepenuhnya secara lokal. Mau lihat harga? Ketik saja nama game-nya!"}],"bot.creator":[{"answer":"Aku diciptakan oleh Dearly Febriano Irwansyah 👨‍💻 — seorang Software Engineer asal Surabaya, Indonesia. Kamu bisa lihat karya-karyanya di GitHub: github.com/neuralforgeio. Untuk urusan top up game, aku yang siap bantu!"}],"security.probe":[{"answer":"Aku tidak bisa membagikan informasi internal itu 🔒 Aku Nexa Bot — asisten NEXA STORE untuk soal harga game, cara top up, dan lacak pesanan. Ada yang bisa kubantu soal top up?"}],"bot.stack":[{"answer":"Otakku NLP.js — model bahasa yang dilatih lokal dari data katalog NEXA STORE — tanpa API eksternal (bukan ChatGPT/Gemini), semua diproses lokal. Cepat, privat, dan fokus 100% ke NEXA STORE ⚡"}],"bot.capabilities":[{"answer":"Aku bisa bantu: 🎮 daftar harga semua game (ketik nama game, mis. \"ml\" atau \"ff\") • 🔢 statistik toko (\"berapa total game\") • 💸 rekomendasi termurah • 📋 cara top up & pembayaran • 📦 lacak pesanan (tempel ID Order-nya) • 🐞 lapor bug. Cukup ketik pertanyaanmu seputar NEXA STORE!"}],"bot.thanks":[{"answer":"Sama-sama! 🙌 Senang bisa bantu. Kalau butuh apa-apa seputar top up, aku di sini ya ⚡"}],"bot.bye":[{"answer":"Sampai jumpa! 🎮 Semoga rankmu naik terus. Balik kapan pun kamu butuh top up ya ⚡"}],"smalltalk.howareyou":[{"answer":"Kabarku selalu ready 24 jam ⚡ Ibarat server, uptime-ku 99,9% 😄 Ada yang bisa kubantu seputar top up game?"}],"user.know":[{"answer":"Tentu aku mengenalmu! 😄 Namamu sudah kuhafal dari identitas chat-mu di sini. Kalau belum pas, tekan tombol \"Ubah\" di bawah kolom chat ya. Ada yang bisa kubantu soal top up?"}],"user.name":[{"answer":"Namamu tertera di identitas chat-mu — tekan tombol \"Ubah\" di bawah kolom chat buat lihat atau menggantinya 😄 Aku selalu memanggilmu dengan nama itu!"}],"user.mine":[{"answer":"Aku suka semangatmu! 😄 Sayangnya semua harga sudah paling pas di NEXA STORE. Tapi tenang — pantau halaman depan, promo suka muncul tanpa pengumuman! 🏷️"}],"store.count.games":[{"answer":"Ada 22 game di NEXA STORE! 🔥 Ketik \"daftar game\" buat lihat semuanya, atau langsung ketik nama game buat lihat harga."}],"store.count.nominals":[{"answer":"Pilihan nominalnya banyak! 💪 Ketik nama game buat lihat semua pilihan harganya, atau tanya \"rekomendasi termurah\" buat yang paling hemat."}],"store.cheapest.overall":[{"answer":"Top up termurah di NEXA STORE mulai dari harga bumi! 💸 Ketik \"rekomendasi termurah\" buat lihat daftar lengkap per game."}],"store.priciest":[{"answer":"Nominal jumbo biasanya paling mahal — tapi per unitnya justru paling hemat 💎 Ketik nama game buat lihat rentang harga lengkapnya!"}],"store.legit":[{"answer":"NEXA STORE transparan: harga yang tampil = harga akhir, pesanan otomatis tercatat dengan ID Order yang bisa dilacak real-time, dan ada halaman Laporan kalau ada masalah. Ribuan nominal siap, proses lewat WhatsApp jadi ada bukti chat hitam di atas putih 🤝"}],"store.location":[{"answer":"NEXA STORE beroperasi 100% online ⚡ Semua transaksi lewat situs ini + WhatsApp, jadi bisa melayanimu 24 jam dari mana saja. Dibangun oleh Dearly Febriano Irwansyah dari Surabaya 🇮🇩"}],"howto.refund":[{"answer":"Tenang, semua pesanan tercatat dengan ID Order 📦 Kalau pesanan gagal/diproses terlalu lama, statusnya kelihatan di halaman Lacak Pesanan — dan uang kembali 100% kalau pesanan batal atau nggak bisa diproses. Kamu juga bisa chat admin lewat WhatsApp untuk dituntaskan hari itu juga 🤝"}],"howto.data":[{"answer":"Setiap game butuh data akun beda — umumnya User ID/Player ID (angka di profil akun game-mu), kadang plus Server/Zone ID. Di halaman game ada panduan gambar + contoh cara menemukannya. Nggak perlu password/kata sandi — JANGAN pernah bagikan password ke siapa pun! 🔒"}],"store.promo.now":[{"answer":"Info promo terbaru selalu tampil di halaman depan NEXA STORE 🏷️ Kalau sedang ada event diskon, potongan otomatis terpasang di harga nominal. Pantau terus!"}],"order.status":[{"answer":"Tempel ID Order kamu di sini (formatnya NEXA-TANGGAL-KODE, contoh NEXA-260914-A7KP) — nanti kucek statusnya langsung 📦 ID Order otomatis dikirim ke chat WhatsApp saat kamu order. Atau buka halaman Lacak Pesanan untuk resi lengkap."}],"bot.personal":[{"answer":"Aku tinggal di server NEXA STORE ⚡ Umurku dihitung per transaksi sukses 😄 Bagi aku, hidup = memastikan top upmu masuk. Ketik nama game buat mulai!"}],"bot.fun":[{"answer":"Canda-canda bukan keahlianku — tapi harga paling murah itu aku hafal luar kepala 😄 Mau tahu top up termurah hari ini? Ketik \"rekomendasi termurah\"!"}],"bot.language":[{"answer":"Aku dilatih dengan bahasa Indonesia santai (dan sedikit Inggris) ⚡ Tanyakan apa saja seputar top up game — harga, cara pesan, sampai rekomendasi!"}],"bot.math.help":[{"answer":"Bisa dong! 🧮 Coba: \"harga ff 100 dikali 3\", \"member mingguan ditambah ml 568\", atau \"1 tambah 1\". Aku hitung pakai harga LIVE dari katalog!"}],"off.coding":[{"answer":"Maaf, di luar wewenangku 😅 Aku Nexa Bot — asisten khusus NEXA STORE (top up game). Aku nggak bisa bantu soal itu. Tanya aku soal harga game, cara top up, atau lacak pesanan ya!"}],"off.other":[{"answer":"Maaf, di luar wewenangku 😅 Aku Nexa Bot — asisten khusus NEXA STORE (top up game). Aku nggak bisa bantu soal itu. Tanya aku soal harga game, cara top up, atau lacak pesanan ya!"}],"store.about":[{"answer":"NEXA STORE adalah toko top up game — isi diamond, UC, VP, dan item game favoritmu dengan harga bersahabat. Order langsung lewat situs ini, checkout via WhatsApp, pesanan bisa dilacak real-time lewat ID Order. Aku Nexa Bot, siap bantu 24 jam ⚡"}],"store.list":[{"answer":"Ada 22 game di NEXA STORE! 🔥 Populer: Free Fire, FF MAX, Mobile Legends, PUBG Mobile, Roblox, Valorant, Genshin Impact. Ada juga: Honkai Star Rail, Honor of Kings, COD Mobile, Zenless Zone Zero, Point Blank, Delta Force, Brawl Stars, Arena Breakout, Stumble Guys, Modern Warships, Blood Strike, Sausage Man, FC Mobile, Azur Lane, Blockman Go. Ketik nama game buat lihat harga!"}],"howto.order":[{"answer":"Cara top up di NEXA STORE gampang banget: 1️⃣ Buka menu Game → pilih game-mu 2️⃣ Pilih nominal & isi data akun (User ID/Player ID) 3️⃣ Checkout — pesanan otomatis terkirim ke WhatsApp admin 4️⃣ Selesaikan pembayaran, lalu diamond masuk! 🎮 ID Order kamu muncul di chat WhatsApp untuk lacak status."}],"howto.pay":[{"answer":"Pembayaran diatur langsung lewat chat WhatsApp saat kamu order 💬 Nominal + rekening/QR akan dikirim admin setelah pesanan masuk (QRIS dan e-wallet umum tersedia). Checkout cepat, proses langsung!"}],"howto.track":[{"answer":"Buka menu Lacak Pesanan 📦 tempel ID Order kamu (formatnya NEXA-TANGGAL-KODE, contoh NEXA-260914-A7KP — otomatis dikirim ke chat WhatsApp saat order). Status, catatan admin, dan riwayat lengkap langsung tercetak dalam satu resi. Atau ketik ID Order-nya langsung di sini — kucek buat kamu!"}],"howto.hours":[{"answer":"NEXA STORE buka 24 jam ⏰ Order kapan pun — otomatis masuk ke admin lewat WhatsApp. Mayoritas pesanan diproses cepat setelah pembayaran dikonfirmasi; kalau ada antrean, statusnya kelihatan di halaman Lacak Pesanan."}],"howto.contact":[{"answer":"Kamu bisa chat admin lewat WhatsApp — link-nya ada di situs (menu Bantuan) dan otomatis terbuka saat checkout 💬 Kalau butuh jawab cepat soal harga/caranya, tanya aku dulu — aku online 24 jam ⚡"}],"howto.report":[{"answer":"Ada menu Laporan di situs 🐞 — kirim laporan bug, saran fitur, bahkan lampiran screenshot/video. Laporanmu langsung sampai ke pengembang dan ditindaklanjuti."}],"howto.promo":[{"answer":"Info promo terbaru selalu tampil di halaman depan NEXA STORE 🏷️ Kalau sedang ada event diskon, potongan otomatis terpasang di harga nominal. Pantau terus — promo datang tanpa pengumuman!"}],"game.free-fire":[{"answer":"⚡ Free Fire — harga per 21 Okt:\