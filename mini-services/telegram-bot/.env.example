# ============================================================
# Nexa Store Telegram Bot — environment template
# Copy ke .env dan isi nilai asli. JANGAN commit .env.
# ============================================================

# Token bot dari @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAA-your-bot-token

# Kode pairing satu kali (buat sendiri, minimal 6 karakter).
# Pemilik mengirim /start lalu memasukkan kode ini untuk mengklaim bot.
PAIRING_CODE=NEXA-XXXXX

# API target yang dikendalikan bot:
# - produksi: https://nexastoregame.vercel.app
# - sandbox lokal: http://localhost:3000
NEXA_API_BASE=https://nexastoregame.vercel.app

# Kredensial DEVELOPER (sama seperti .env aplikasi utama).
NEXA_DEV_EMAIL=developer@example.com
NEXA_DEV_PASSWORD=change-me

# Vercel (fitur deployment & redeploy commit).
VERCEL_TOKEN=vcp-xxxx
VERCEL_TEAM=team_xxxxxxxx
VERCEL_PROJECT=nexastoregame
VERCEL_ORG_ID=123456789
VERCEL_REPO_ID=123456789

# GitHub (daftar commit; repo privat butuh PAT).
GITHUB_TOKEN=ghp_xxxx
GITHUB_REPO=neuralforgeio/Nexa-Store
GITHUB_BRANCH=main

# Path repo lokal (sinkronisasi sandbox pasca tulis produksi).
REPO_DIR=/home/z/my-project
